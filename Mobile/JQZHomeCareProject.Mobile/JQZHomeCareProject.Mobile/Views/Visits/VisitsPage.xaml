<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Visits"
             xmlns:models="clr-namespace:JQZHomeCareProject.Mobile.Models.Visits"
             x:Class="JQZHomeCareProject.Mobile.Views.Visits.VisitsPage"
             x:DataType="vm:VisitsViewModel"
             BackgroundColor="#FBF4F4"
             Title="Visits">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="JqzRed">#E11B22</Color>
            <Color x:Key="JqzRedDark">#B5121B</Color>
            <Color x:Key="JqzRedSoft">#FDECEC</Color>
            <Color x:Key="InkDark">#191A2E</Color>
            <Color x:Key="InkMuted">#8A8FA3</Color>

            <!-- Section status pill colors -->
            <Color x:Key="UpcomingText">#E11B22</Color>
            <Color x:Key="UpcomingBg">#FDECEC</Color>
            <Color x:Key="InProgressText">#2E7D32</Color>
            <Color x:Key="InProgressBg">#E6F4EA</Color>
            <Color x:Key="CompletedText">#55606B</Color>
            <Color x:Key="CompletedBg">#EEF1F4</Color>
            <Color x:Key="CancelledText">#C62828</Color>
            <Color x:Key="CancelledBg">#FBE4E4</Color>

            <Shadow x:Key="CardShadow"
                    Brush="#191A2E"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.06" />

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
            </Style>

            <Style x:Key="SectionHeaderLabel" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource InkDark}" />
            </Style>

            <Style x:Key="StatusPillLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="ChevronLabel" TargetType="Label">
                <Setter Property="Text" Value="&#x203A;" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="#C9CDDA" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 RefreshColor="{StaticResource JqzRed}"
                 BackgroundColor="Transparent">
        <ScrollView BackgroundColor="Transparent">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="22">

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource JqzRedDark}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <!-- ===== UPCOMING ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding UpcomingVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding UpcomingVisits.Count, StringFormat='Upcoming ({0})'}" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 14"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource UpcomingBg}"
                                Padding="12,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource UpcomingText}" VerticalOptions="Center" />
                                <Label Text="Upcoming" Style="{StaticResource StatusPillLabel}" TextColor="{StaticResource UpcomingText}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:UpcomingVisitItem">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                              CommandParameter="{Binding Visit}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">

                                        <!-- Time -->
                                        <Label Grid.Column="0"
                                               Text="{Binding TimeSlot}"
                                               FontSize="13.5"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource JqzRed}"
                                               VerticalOptions="Center" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                            <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />

                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding ExpectedAmountDisplay}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                                <Border StrokeShape="RoundRectangle 8"
                                                        Stroke="Transparent"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{StaticResource JqzRedSoft}"
                                                        Padding="7,3"
                                                        IsVisible="{Binding IsOverdue}">
                                                    <Label Text="{Binding OverdueLabel}" FontSize="10.5" FontAttributes="Bold" TextColor="{StaticResource JqzRedDark}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Style="{StaticResource ChevronLabel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== IN PROGRESS ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding InProgressVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding InProgressVisits.Count, StringFormat='In Progress ({0})'}" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 14"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource InProgressBg}"
                                Padding="12,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource InProgressText}" VerticalOptions="Center" />
                                <Label Text="In Progress" Style="{StaticResource StatusPillLabel}" TextColor="{StaticResource InProgressText}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding InProgressVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VisitDto">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">

                                        <!-- Time -->
                                        <Label Grid.Column="0"
                                               Text="{Binding TimeSlot}"
                                               FontSize="13.5"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource JqzRed}"
                                               VerticalOptions="Center" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                            <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                            <Label Text="{Binding ExpectedAmountDisplay}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Style="{StaticResource ChevronLabel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== COMPLETED ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding CompletedVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding CompletedVisits.Count, StringFormat='Completed ({0})'}" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 14"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource CompletedBg}"
                                Padding="12,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource CompletedText}" VerticalOptions="Center" />
                                <Label Text="Completed" Style="{StaticResource StatusPillLabel}" TextColor="{StaticResource CompletedText}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VisitDto">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">

                                        <Label Grid.Column="0"
                                               Text="{Binding ScheduledDateTimeLabel}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource InkMuted}"
                                               VerticalOptions="Start"
                                               Margin="0,2,0,0" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                            <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                            <Label Text="{Binding PaymentSummary}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Style="{StaticResource ChevronLabel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== CANCELLED ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding CancelledVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding CancelledVisits.Count, StringFormat='Cancelled ({0})'}" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 14"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource CancelledBg}"
                                Padding="12,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource CancelledText}" VerticalOptions="Center" />
                                <Label Text="Cancelled" Style="{StaticResource StatusPillLabel}" TextColor="{StaticResource CancelledText}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CancelledVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VisitDto">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">

                                        <Label Grid.Column="0"
                                               Text="{Binding ScheduledDateTimeLabel}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource InkMuted}"
                                               VerticalOptions="Start"
                                               Margin="0,2,0,0" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                            <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                            <Label Text="{Binding CancellationReason, StringFormat='Reason: {0}'}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource CancelledText}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Style="{StaticResource ChevronLabel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Empty state -->
                <VerticalStackLayout Spacing="8"
                                      HorizontalOptions="Center"
                                      Padding="0,30"
                                      IsVisible="{Binding HasNoVisits}">
                    <Label Text="No visits to show" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" HorizontalTextAlignment="Center" />
                    <Label Text="Pull down to refresh." FontSize="13" TextColor="{StaticResource InkMuted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>