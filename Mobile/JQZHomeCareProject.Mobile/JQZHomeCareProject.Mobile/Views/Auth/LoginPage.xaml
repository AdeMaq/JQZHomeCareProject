<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Auth"
             x:Class="JQZHomeCareProject.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid>
        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="24" Spacing="16">

                <Image Source="app_logo.png"
                       HeightRequest="90"
                       WidthRequest="90"
                       HorizontalOptions="Center"
                       Margin="0,0,0,16" />

                <Label Text="Practitioner Login"
                       Style="{StaticResource HeadingLabel}"
                       HorizontalOptions="Center" />

                <Entry Placeholder="Email"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0"
                           Placeholder="Password"
                           IsPassword="{Binding IsPasswordHidden}"
                           Text="{Binding Password}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                    <Button Grid.Column="1"
                            Text="{Binding IsPasswordHidden, Converter={StaticResource PasswordToggleTextConverter}}"
                            Command="{Binding ToggleShowPasswordCommand}"
                            Style="{StaticResource TextOnlyButton}" />
                </Grid>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource ErrorColor}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <Button Text="Log In"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>