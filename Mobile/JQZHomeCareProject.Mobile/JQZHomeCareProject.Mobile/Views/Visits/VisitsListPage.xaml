<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Visits"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:JQZHomeCareProject.Mobile.Models.Visits"
             x:Class="JQZHomeCareProject.Mobile.Views.Visits.VisitsListPage"
             x:DataType="vm:VisitsListViewModel"
             Title="Visits"
             BackgroundColor="#FBF4F4">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#E11B22"
                                     StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="JqzRed">#E11B22</Color>
            <Color x:Key="JqzRedDark">#B5121B</Color>
            <Color x:Key="JqzRedSoft">#FDECEC</Color>
            <Color x:Key="InkDark">#191A2E</Color>
            <Color x:Key="InkMuted">#8A8FA3</Color>
            <Color x:Key="HairLine">#E4E7EF</Color>

            <Shadow x:Key="CardShadow"
                    Brush="#191A2E"
                    Offset="0,6"
                    Radius="16"
                    Opacity="0.08" />

            <Style x:Key="FilterChip" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
                <Setter Property="BorderColor" Value="{StaticResource HairLine}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="20,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
            </Style>

            <Style x:Key="VisitCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 RefreshColor="{StaticResource JqzRed}"
                 BackgroundColor="Transparent">

        <CollectionView ItemsSource="{Binding GroupedVisits}"
                        IsGrouped="True"
                        SelectionMode="None"
                        BackgroundColor="Transparent">

            <!-- ============ HEADER ============ -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,18,20,6" Spacing="16">

                    <!-- Filter chips -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" Padding="2,4,2,4">

                            <Button Text="Week"
                                    Style="{StaticResource FilterChip}"
                                    Command="{Binding ChangeFilterCommand}"
                                    CommandParameter="{x:Static vm:VisitDateFilter.Week}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Week}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource JqzRed}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{StaticResource JqzRed}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Month"
                                    Style="{StaticResource FilterChip}"
                                    Command="{Binding ChangeFilterCommand}"
                                    CommandParameter="{x:Static vm:VisitDateFilter.Month}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Month}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource JqzRed}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{StaticResource JqzRed}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Custom"
                                    Style="{StaticResource FilterChip}"
                                    Command="{Binding ChangeFilterCommand}"
                                    CommandParameter="{x:Static vm:VisitDateFilter.Custom}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Custom}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource JqzRed}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{StaticResource JqzRed}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Custom range card -->
                    <Border IsVisible="{Binding IsCustomRangeVisible}"
                            Style="{StaticResource VisitCard}">
                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="From" FontSize="11" TextColor="{StaticResource InkMuted}" Margin="4,0,0,0" />
                                    <Border StrokeShape="RoundRectangle 12"
                                            Stroke="{StaticResource HairLine}"
                                            StrokeThickness="1"
                                            Padding="10,0"
                                            HeightRequest="44">
                                        <DatePicker Date="{Binding CustomStartDate}"
                                                    Format="dd MMM yyyy"
                                                    FontSize="13"
                                                    TextColor="{StaticResource InkDark}"
                                                    BackgroundColor="Transparent"
                                                    VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="To" FontSize="11" TextColor="{StaticResource InkMuted}" Margin="4,0,0,0" />
                                    <Border StrokeShape="RoundRectangle 12"
                                            Stroke="{StaticResource HairLine}"
                                            StrokeThickness="1"
                                            Padding="10,0"
                                            HeightRequest="44">
                                        <DatePicker Date="{Binding CustomEndDate}"
                                                    Format="dd MMM yyyy"
                                                    FontSize="13"
                                                    TextColor="{StaticResource InkDark}"
                                                    BackgroundColor="Transparent"
                                                    VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Apply Range"
                                    Command="{Binding ApplyCustomRangeCommand}"
                                    BackgroundColor="{StaticResource JqzRed}"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="44"
                                    CornerRadius="12" />

                        </VerticalStackLayout>
                    </Border>

                    <!-- Error -->
                    <Border BackgroundColor="{StaticResource JqzRedSoft}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,10"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextColor="{StaticResource JqzRedDark}" />
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ============ DATE GROUP HEADER ============ -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:VisitDateGroup">
                    <Grid Padding="22,16,20,6" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <BoxView Grid.Column="0"
                                 WidthRequest="6"
                                 HeightRequest="6"
                                 CornerRadius="3"
                                 Color="{StaticResource JqzRed}"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding DateLabel}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource InkDark}"
                               VerticalOptions="Center" />
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 Color="{StaticResource HairLine}"
                                 VerticalOptions="Center"
                                 Margin="6,0,0,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- ============ VISIT CARD ============ -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VisitDto">
                    <Grid Padding="20,6">
                        <Border Style="{StaticResource VisitCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsListViewModel}}, Path=OpenVisitCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">

                                <!-- Time -->
                                <Label Grid.Column="0"
                                       Text="{Binding TimeSlot}"
                                       FontSize="13.5"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource JqzRed}"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding PatientName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource InkDark}" />
                                    <Label Text="{Binding AreaName}"
                                           FontSize="12.5"
                                           TextColor="{StaticResource InkMuted}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Status badge -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 9"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        Padding="9,5"
                                        VerticalOptions="Center"
                                        BackgroundColor="{Binding Status, Converter={StaticResource VisitStatusToColorConverter}}">
                                    <Label Text="{Binding Status}"
                                           FontSize="10.5"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ============ EMPTY STATE ============ -->
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30,36" Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="76"
                            HeightRequest="76"
                            BackgroundColor="{StaticResource JqzRedSoft}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26"
                            HorizontalOptions="Center">
                        <Label Text="&#x1F5D3;"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No visits in this range"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkDark}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Try a different date filter."
                           FontSize="13"
                           TextColor="{StaticResource InkMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </RefreshView>

</ContentPage>