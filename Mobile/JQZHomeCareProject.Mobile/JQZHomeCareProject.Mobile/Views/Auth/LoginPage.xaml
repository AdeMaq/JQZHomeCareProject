<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Auth"
             x:Class="JQZHomeCareProject.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FBFBFD">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="JqzRed">#E11B22</Color>
            <Color x:Key="JqzRedDark">#B5121B</Color>
            <Color x:Key="InkDark">#191A2E</Color>
            <Color x:Key="InkMuted">#8A8FA3</Color>
            <Color x:Key="FieldStroke">#E4E7EF</Color>

            <!-- Stronger pink, held longer before it fades into the curve -->
            <LinearGradientBrush x:Key="WashBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FBD9DC" Offset="0.0" />
                <GradientStop Color="#FBD9DC" Offset="0.8" />
                <GradientStop Color="#FBD9DC" Offset="1.0" />
            </LinearGradientBrush>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource InkDark}" />
                <Setter Property="Margin" Value="4,0,0,6" />
            </Style>

            <Style x:Key="FieldShell" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Stroke" Value="{StaticResource FieldStroke}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="14,2" />
                <Setter Property="HeightRequest" Value="54" />
            </Style>

            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource InkDark}" />
                <Setter Property="PlaceholderColor" Value="#B6BBC9" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- Curved wash -->
        <Border VerticalOptions="Start"
                HeightRequest="300"
                Background="{StaticResource WashBrush}"
                Stroke="Transparent"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,70,70" />

        <!-- Main content: Grid instead of ScrollView + StackLayout, so rows actually fill the width -->
        <Grid Padding="28,40"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              VerticalOptions="Center"
              HorizontalOptions="Fill">

            <!-- Brand -->
            <Image Grid.Row="0"
                   Source="jqz_transparent.png"
                   HeightRequest="180"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Grid.Row="1"
                   Text="HOME CARE  ·  THERAPIST APP"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource JqzRed}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,34" />

            <!-- Heading -->
            <Label Grid.Row="2"
                   Text="Welcome back!"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource InkDark}"
                   HorizontalOptions="Center" />

            <Label Grid.Row="3"
                   Text="Please sign in to continue"
                   FontSize="14"
                   TextColor="{StaticResource InkMuted}"
                   HorizontalOptions="Center"
                   Margin="0,6,0,28" />

            <!-- Practitioner Email (still bound to Email property) -->
            <Label Grid.Row="4" Text="Practitioner Email" Style="{StaticResource FieldLabel}" />
            <Border Grid.Row="5" Style="{StaticResource FieldShell}">
                <Entry Placeholder="you@jqz.com"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       Style="{StaticResource FieldEntry}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Border>

            <!-- Password -->
            <Label Grid.Row="6" Text="Password" Style="{StaticResource FieldLabel}" Margin="4,20,0,6" />
            <Border Grid.Row="7" Style="{StaticResource FieldShell}" Padding="14,2,6,2">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0"
                           Placeholder="••••••••"
                           IsPassword="{Binding IsPasswordHidden}"
                           Text="{Binding Password}"
                           Style="{StaticResource FieldEntry}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    <Button Grid.Column="1"
                            Text="{Binding IsPasswordHidden, Converter={StaticResource PasswordToggleTextConverter}}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource InkMuted}"
                            FontSize="13"
                            Padding="10,0"
                            MinimumWidthRequest="48"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Remember me + Forgot password row: fills full width now, so * pushes them apart -->
            <Grid Grid.Row="8"
                  ColumnDefinitions="Auto,*,Auto"
                  HorizontalOptions="Fill"
                  Margin="2,16,4,0"
                  VerticalOptions="Center">

                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <CheckBox Color="{StaticResource JqzRed}"
                              Scale="0.9"
                              VerticalOptions="Center" />
                    <!--
                    Wire this up once a RememberMe bool exists on LoginViewModel:
                    IsChecked="{Binding RememberMe}"
                    -->
                    <Label Text="Remember me"
                           FontSize="14"
                           TextColor="{StaticResource InkDark}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Forgot password.
                     Uncomment the gesture once ForgotPasswordCommand exists on the VM. -->
                <Label Grid.Column="2"
                       Text="Forgot Password?"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource JqzRed}"
                       VerticalOptions="Center">
                    <!--
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                    -->
                </Label>

            </Grid>

            <!-- Error -->
            <Border Grid.Row="9"
                    BackgroundColor="#FDECEC"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10"
                    Margin="0,18,0,0"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{StaticResource JqzRedDark}"
                       HorizontalTextAlignment="Center" />
            </Border>

            <!-- Submit -->
            <Button Grid.Row="10"
                    Text="Login"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="{StaticResource JqzRed}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="54"
                    CornerRadius="16"
                    Margin="0,26,0,0">
                <Button.Shadow>
                    <Shadow Brush="#E11B22" Offset="0,8" Radius="18" Opacity="0.35" />
                </Button.Shadow>
            </Button>

        </Grid>

        <!-- Version stamp -->
        <Label Text="Version 1.0.0"
               FontSize="12"
               TextColor="#B6BBC9"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,22" />

        <!-- Busy overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66FFFFFF">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Color="{StaticResource JqzRed}" />
        </Grid>

    </Grid>

</ContentPage>