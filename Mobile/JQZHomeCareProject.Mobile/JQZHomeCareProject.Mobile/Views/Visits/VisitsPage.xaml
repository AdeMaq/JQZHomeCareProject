<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Visits"
             xmlns:models="clr-namespace:JQZHomeCareProject.Mobile.Models.Visits"
             x:Class="JQZHomeCareProject.Mobile.Views.Visits.VisitsPage"
             x:DataType="vm:VisitsViewModel"
             BackgroundColor="#F6F7FB"
             Title="Visits">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="JqzRed">#E11B22</Color>
            <Color x:Key="InkDark">#191A2E</Color>
            <Color x:Key="InkMuted">#8A8FA3</Color>
            <Color x:Key="StatusUpcoming">#2196F3</Color>
            <Color x:Key="StatusInProgress">#FF9800</Color>
            <Color x:Key="StatusCompleted">#4CAF50</Color>
            <Color x:Key="StatusCancelled">#F44336</Color>

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Shadow">
                    <Shadow Brush="#191A2E" Offset="0,4" Radius="12" Opacity="0.06" />
                </Setter>
            </Style>

            <Style x:Key="SectionHeaderLabel" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource InkDark}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 RefreshColor="{StaticResource JqzRed}"
                 BackgroundColor="Transparent">
        <ScrollView BackgroundColor="Transparent">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="22">

                <Label Text="Visits" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#B5121B"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <!-- ===== UPCOMING ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding UpcomingVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="{StaticResource StatusUpcoming}" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Label Grid.Column="1" Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding UpcomingVisits.Count, StringFormat='Upcoming ({0})'}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VisitDto">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="66" BackgroundColor="#E9F3FE"
                                                StrokeShape="RoundRectangle 10" Padding="6,8" VerticalOptions="Start">
                                            <Label Text="{Binding TimeSlot}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource StatusUpcoming}" HorizontalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                            <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                            <Label Text="{Binding ExpectedAmountDisplay}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource StatusUpcoming}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== IN PROGRESS ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding InProgressVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="{StaticResource StatusInProgress}" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Label Grid.Column="1" Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding InProgressVisits.Count, StringFormat='In Progress ({0})'}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding InProgressVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VisitDto">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="66" BackgroundColor="#FFF1DE"
                                                StrokeShape="RoundRectangle 10" Padding="6,8" VerticalOptions="Start">
                                            <Label Text="{Binding TimeSlot}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource StatusInProgress}" HorizontalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                            <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                            <Label Text="{Binding ExpectedAmountDisplay}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource StatusInProgress}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== COMPLETED ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding CompletedVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="{StaticResource StatusCompleted}" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Label Grid.Column="1" Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding CompletedVisits.Count, StringFormat='Completed ({0})'}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VisitDto">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding ScheduledDateTimeLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource InkMuted}" />
                                        <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                        <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                        <Label Text="{Binding PaymentSummary}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource StatusCompleted}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== CANCELLED ===== -->
                <VerticalStackLayout Spacing="10"
                                      IsVisible="{Binding CancelledVisits.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="{StaticResource StatusCancelled}" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Label Grid.Column="1" Style="{StaticResource SectionHeaderLabel}"
                               Text="{Binding CancelledVisits.Count, StringFormat='Cancelled ({0})'}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CancelledVisits}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:VisitDto">
                                <Border Style="{StaticResource SectionCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsViewModel}}, Path=OpenVisitCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding ScheduledDateTimeLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource InkMuted}" />
                                        <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" />
                                        <Label Text="{Binding PatientAddress}" FontSize="12.5" TextColor="{StaticResource InkMuted}" />
                                        <Label Text="{Binding CancellationReason, StringFormat='Reason: {0}'}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource StatusCancelled}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Empty state -->
                <VerticalStackLayout Spacing="8"
                                      HorizontalOptions="Center"
                                      Padding="0,30"
                                      IsVisible="{Binding HasNoVisits}">
                    <Label Text="No visits to show" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource InkDark}" HorizontalTextAlignment="Center" />
                    <Label Text="Pull down to refresh." FontSize="13" TextColor="{StaticResource InkMuted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>