# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

## =========================
## Source code - force LF
## =========================
*.cs      text eol=lf
*.csproj  text eol=lf
*.sln     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.xaml    text eol=lf
*.ts      text eol=lf
*.html    text eol=lf
*.scss    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

## =========================
## Windows-only files - force CRLF
## =========================
*.bat  text eol=crlf
*.ps1  text eol=crlf

## =========================
## Binary files - do not touch line endings, do not diff
## =========================
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.dll   binary
*.exe   binary
*.apk   binary
*.aab   binary
*.ipa   binary
*.appx  binary
*.msix  binary
*.mdf   binary
*.ldf   binary