<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Visits"
             xmlns:models="clr-namespace:JQZHomeCareProject.Mobile.Models.Visits"
             x:Class="JQZHomeCareProject.Mobile.Views.Visits.VisitsListPage"
             x:DataType="vm:VisitsListViewModel"
             Title="Visits">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding GroupedVisits}"
                         IsGrouped="True"
                         SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Padding="20,16,20,8" Spacing="12">

                    <!-- Filter chips -->
                    <HorizontalStackLayout Spacing="10">

                        <Button Text="Week"
                                Command="{Binding ChangeFilterCommand}"
                                CommandParameter="{x:Static vm:VisitDateFilter.Week}"
                                CornerRadius="16" Padding="16,6" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Week}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="Month"
                                Command="{Binding ChangeFilterCommand}"
                                CommandParameter="{x:Static vm:VisitDateFilter.Month}"
                                CornerRadius="16" Padding="16,6" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Month}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="Custom"
                                Command="{Binding ChangeFilterCommand}"
                                CommandParameter="{x:Static vm:VisitDateFilter.Custom}"
                                CornerRadius="16" Padding="16,6" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Custom}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                    </HorizontalStackLayout>

                    <!-- Custom range picker -->
                    <Grid ColumnDefinitions="*,*,Auto"
                          ColumnSpacing="8"
                          IsVisible="{Binding IsCustomRangeVisible}">
                        <DatePicker Grid.Column="0" Date="{Binding CustomStartDate}" Format="dd MMM yyyy" />
                        <DatePicker Grid.Column="1" Date="{Binding CustomEndDate}" Format="dd MMM yyyy" />
                        <Button Grid.Column="2" Text="Apply" Command="{Binding ApplyCustomRangeCommand}" Padding="12,6" FontSize="13" />
                    </Grid>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource ErrorRed}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:VisitDateGroup">
                    <Label Text="{Binding DateLabel}"
                           FontAttributes="Bold"
                           FontSize="14"
                           Padding="20,8"
                           BackgroundColor="#F2F2F2" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VisitDto">
                    <Grid Padding="20,6">
                        <Border StrokeShape="RoundRectangle 12" Padding="14" BackgroundColor="White" Stroke="LightGray">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitsListViewModel}}, Path=OpenVisitCommand}"
                                                       CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{Binding TimeSlot}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       VerticalOptions="Start" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding PatientName}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding AreaName}" FontSize="13" TextColor="Gray" />
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,4"
                                        VerticalOptions="Start"
                                        BackgroundColor="{Binding Status, Converter={StaticResource VisitStatusToColorConverter}}">
                                    <Label Text="{Binding Status}" FontSize="11" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20,40" HorizontalOptions="Center" Spacing="8">
                    <Label Text="No visits in this range" FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </RefreshView>

</ContentPage>