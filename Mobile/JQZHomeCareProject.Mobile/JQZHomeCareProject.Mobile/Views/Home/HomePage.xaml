<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Home"
             xmlns:models="clr-namespace:JQZHomeCareProject.Mobile.Models.Visits"
             x:Class="JQZHomeCareProject.Mobile.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home"
             BackgroundColor="#FBF4F4">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="JqzRed">#E11B22</Color>
            <Color x:Key="JqzRedDark">#B5121B</Color>
            <Color x:Key="JqzRedSoft">#FDECEC</Color>
            <Color x:Key="InkDark">#191A2E</Color>
            <Color x:Key="InkMuted">#8A8FA3</Color>

            <Shadow x:Key="CardShadow"
                    Brush="#191A2E"
                    Offset="0,6"
                    Radius="16"
                    Opacity="0.08" />

            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="10,16" />
                <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
            </Style>

            <Style x:Key="StatValue" TargetType="Label">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource InkDark}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="StatCaption" TargetType="Label">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="VisitCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="16,15" />
                <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 RefreshColor="{StaticResource JqzRed}"
                 BackgroundColor="Transparent">

        <CollectionView ItemsSource="{Binding TodaysVisits}" SelectionMode="None" BackgroundColor="Transparent">

            <!-- ============ HEADER ============ -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,20,20,6" Spacing="18">

                    <!-- Greeting -->
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding GreetingLine}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource InkDark}" />
                        <Label Text="{Binding TodayDateText}"
                               FontSize="13.5"
                               TextColor="{StaticResource InkMuted}" />
                    </VerticalStackLayout>

                    <!-- Stat cards -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                        <Border Grid.Column="0" Style="{StaticResource StatCard}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="&#x1F4C5;" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="{Binding TodaysVisits.Count}" Style="{StaticResource StatValue}" />
                                <Label Text="Today Visits" Style="{StaticResource StatCaption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatCard}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="&#x1F4B5;" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="{Binding ExpectedAmountTodayDisplay}"
                                       Style="{StaticResource StatValue}"
                                       FontSize="15.5" />
                                <Label Text="Expected Amount Today"
                                       Style="{StaticResource StatCaption}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRatingsCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="&#x2B50;" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="{Binding LatestRatingDisplay}" Style="{StaticResource StatValue}" />
                                <Label Text="Ratings" Style="{StaticResource StatCaption}" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- Error banner -->
                    <Border BackgroundColor="{StaticResource JqzRedSoft}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,10"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextColor="{StaticResource JqzRedDark}" />
                    </Border>

                    <!-- Schedule section header -->
                    <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,0">
                        <Label Grid.Column="0"
                               Text="Today's Schedule"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource InkDark}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="View All"
                               FontSize="13.5"
                               FontAttributes="Bold"
                               TextColor="{StaticResource JqzRed}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllVisitsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ============ VISIT CARD ============ -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VisitDto">
                    <Grid Padding="20,7">
                        <Border Style="{StaticResource VisitCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenVisitCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">

                                <Label Grid.Column="0"
                                       Text="{Binding TimeSlot}"
                                       FontSize="13.5"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource JqzRed}"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding PatientName}"
                                           FontSize="15.5"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource InkDark}" />
                                    <Label Text="{Binding PatientAddress}"
                                           FontSize="13"
                                           TextColor="{StaticResource InkMuted}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="&#x203A;"
                                       FontSize="24"
                                       TextColor="#C9CDDA"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ============ EMPTY STATE ============ -->
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30,36" Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="76"
                            HeightRequest="76"
                            BackgroundColor="{StaticResource JqzRedSoft}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26"
                            HorizontalOptions="Center">
                        <Label Text="&#x1F4C5;"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No visits scheduled today"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkDark}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Pull down to refresh your schedule."
                           FontSize="13"
                           TextColor="{StaticResource InkMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </RefreshView>

</ContentPage>