<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:JQZHomeCareProject.Mobile.Views"
       x:Class="JQZHomeCareProject.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home"
                      Route="home"
                      Icon="icon_home.png"
                      ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent Title="Visits"
                      Route="visits"
                      Icon="icon_visits.png"
                      ContentTemplate="{DataTemplate views:VisitsListPage}" />

        <ShellContent Title="Earnings"
                      Route="earnings"
                      Icon="icon_earnings.png"
                      ContentTemplate="{DataTemplate views:EarningsPage}" />

        <ShellContent Title="Profile"
                      Route="profile"
                      Icon="icon_profile.png"
                      ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>