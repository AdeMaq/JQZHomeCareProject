<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Home"
             xmlns:models="clr-namespace:JQZHomeCareProject.Mobile.Models.Visits"
             x:Class="JQZHomeCareProject.Mobile.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F6F7FB"
             Title="Home">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="JqzRed">#E11B22</Color>
            <Color x:Key="JqzRedDark">#B5121B</Color>
            <Color x:Key="JqzRedSoft">#FDECEC</Color>
            <Color x:Key="PageBg">#F6F7FB</Color>
            <Color x:Key="InkDark">#191A2E</Color>
            <Color x:Key="InkMuted">#8A8FA3</Color>
            <Color x:Key="HairLine">#EDEFF5</Color>

            <!-- Curved header wash -->
            <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C9101A" Offset="0.0" />
                <GradientStop Color="#E11B22" Offset="0.55" />
                <GradientStop Color="#FF4A50" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Soft elevation used by every floating card -->
            <Shadow x:Key="CardShadow"
                    Brush="#191A2E"
                    Offset="0,8"
                    Radius="20"
                    Opacity="0.10" />

            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="12,14" />
                <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
            </Style>

            <Style x:Key="StatValue" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource JqzRed}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="StatCaption" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 RefreshColor="{StaticResource JqzRed}"
                 BackgroundColor="Transparent">

        <CollectionView ItemsSource="{Binding TodaysVisits}" SelectionMode="None" BackgroundColor="Transparent">

            <!-- ============ HEADER ============ -->
            <CollectionView.Header>
                <Grid>

                    <!-- Curved red wash sitting behind the top content -->
                    <Border VerticalOptions="Start"
                            HeightRequest="230"
                            Background="{StaticResource HeaderBrush}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 0,0,46,46" />

                    <VerticalStackLayout Padding="20,0,20,6" Spacing="16">

                        <!-- Logo badge + brand -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              Margin="0,18,0,0">

                            <Border Grid.Column="0"
                                    WidthRequest="54"
                                    HeightRequest="54"
                                    Padding="6"
                                    BackgroundColor="White"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <Border.Shadow>
                                    <Shadow Brush="#7A0A10" Offset="0,4" Radius="12" Opacity="0.25" />
                                </Border.Shadow>
                                <Image Source="jqz_transparent.png"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Text="JQZ Home Care"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Therapist App"
                                       FontSize="12"
                                       TextColor="#FFD9DB" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="#33FFFFFF"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    VerticalOptions="Center">
                                <Label Text="&#x1F514;"
                                       FontSize="16"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Greeting -->
                        <VerticalStackLayout Spacing="3" Margin="2,4,0,0">
                            <Label Text="{Binding GreetingLine}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding TodayDateText}"
                                   FontSize="13"
                                   TextColor="#FFCED1" />
                        </VerticalStackLayout>

                        <!-- Floating summary cards, straddling the curve -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,6,0,0">

                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding TodaysVisits.Count}" Style="{StaticResource StatValue}" />
                                    <Label Text="Today's Visits" Style="{StaticResource StatCaption}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding ExpectedAmountTodayDisplay}"
                                           Style="{StaticResource StatValue}"
                                           FontSize="17" />
                                    <Label Text="Expected Today" Style="{StaticResource StatCaption}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenRatingsCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding LatestRatingDisplay}"
                                           Style="{StaticResource StatValue}"
                                           FontSize="17" />
                                    <Label Text="My Rating" Style="{StaticResource StatCaption}" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <!-- Error banner -->
                        <Border BackgroundColor="{StaticResource JqzRedSoft}"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10"
                                Margin="0,4,0,0"
                                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="{StaticResource JqzRedDark}" />
                        </Border>

                        <!-- Schedule section header -->
                        <Grid ColumnDefinitions="*,Auto" Margin="2,10,2,0">
                            <Label Grid.Column="0"
                                   Text="Today's Schedule"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource InkDark}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="View All"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource JqzRed}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewAllVisitsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                    </VerticalStackLayout>
                </Grid>
            </CollectionView.Header>

            <!-- ============ VISIT CARD ============ -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VisitDto">
                    <Grid Padding="20,7">
                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                BackgroundColor="White"
                                Padding="14">
                            <Border.Shadow>
                                <Shadow Brush="#191A2E" Offset="0,6" Radius="16" Opacity="0.07" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenVisitCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,4,*,Auto" ColumnSpacing="12">

                                <!-- Time pill -->
                                <Border Grid.Column="0"
                                        WidthRequest="66"
                                        BackgroundColor="#FDECEC"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="6,10"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding TimeSlot}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#C9101A"
                                           HorizontalTextAlignment="Center" />
                                </Border>

                                <!-- Red accent rule -->
                                <BoxView Grid.Column="1"
                                         WidthRequest="3"
                                         HeightRequest="34"
                                         CornerRadius="2"
                                         Color="#F3D5D6"
                                         VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding PatientName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#191A2E" />
                                    <Label Text="{Binding PatientAddress}"
                                           FontSize="12.5"
                                           TextColor="#8A8FA3"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                </VerticalStackLayout>

                                <Label Grid.Column="3"
                                       Text="&#x203A;"
                                       FontSize="26"
                                       TextColor="#C9CDDA"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ============ EMPTY STATE ============ -->
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30,36" Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="76"
                            HeightRequest="76"
                            BackgroundColor="#FDECEC"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26"
                            HorizontalOptions="Center">
                        <Label Text="&#x1F4C5;"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No visits scheduled today"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#191A2E"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Pull down to refresh your schedule."
                           FontSize="13"
                           TextColor="#8A8FA3"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </RefreshView>

</ContentPage>
