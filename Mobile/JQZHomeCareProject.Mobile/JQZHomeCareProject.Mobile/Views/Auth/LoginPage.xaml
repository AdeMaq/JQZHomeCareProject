<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JQZHomeCareProject.Mobile.ViewModels.Auth"
             x:Class="JQZHomeCareProject.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="Black">

    <Grid>
        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="30,0" Spacing="16" MaximumWidthRequest="400" HorizontalOptions="Center">

                <Image Source="app_logo.png"
                       HeightRequest="96"
                       HorizontalOptions="Center"
                       Margin="0,0,0,24" />

                <Label Text="Practitioner Login"
                       Style="{StaticResource HeaderLabel}"
                       HorizontalOptions="Center" />

                <Entry Placeholder="Email"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0"
                           Placeholder="Password"
                           IsPassword="{Binding IsPasswordHidden}"
                           Text="{Binding Password}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    <Button Grid.Column="1"
                            Text="{Binding IsPasswordHidden, Converter={StaticResource PasswordToggleTextConverter}}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}" />
                </Grid>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource ErrorRed}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                       HorizontalTextAlignment="Center" />

                <Button Text="Log In"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Color="{StaticResource Primary}" />
    </Grid>

</ContentPage>